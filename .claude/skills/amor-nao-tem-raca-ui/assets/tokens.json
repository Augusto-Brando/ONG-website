{
  "$description": "Amor Não Tem Raça · sementes do tema no formato Design Tokens (W3C). Use as sementes para gerar a paleta oklch clara e escura do Astryx. Os demais valores espelham assets/tokens.css.",
  "seed": {
    "primary": { "$type": "color", "$value": "#0077B3", "$description": "Azul da confiança. Texto e botões azuis." },
    "action": { "$type": "color", "$value": "#F7791A", "$description": "Laranja do cachorro. Botão principal com texto neutral.ink." },
    "accent": { "$type": "color", "$value": "#FFD84D", "$description": "Amarelo do sol. Só áreas, nunca texto." },
    "neutral": { "$type": "color", "$value": "#122334", "$description": "Tinta. Neutra fria-escura." },
    "support": { "$type": "color", "$value": "#A85A3E", "$description": "Marrom do gato. Ilustrações." }
  },
  "color": {
    "primary": {
      "base": { "$type": "color", "$value": "#0077B3" },
      "logo": { "$type": "color", "$value": "#008AC8", "$description": "Somente áreas e títulos >= 24px" },
      "strong": { "$type": "color", "$value": "#0B3F5E" },
      "subtle": { "$type": "color", "$value": "#E4F3FB" },
      "onSubtle": { "$type": "color", "$value": "#005C88" }
    },
    "action": {
      "base": { "$type": "color", "$value": "#F7791A" },
      "on": { "$type": "color", "$value": "#122334", "$description": "Texto sobre o laranja. Branco reprova AA (2,7:1)." },
      "step": { "$type": "color", "$value": "#B84A06", "$description": "Sombra em degrau do botão" },
      "text": { "$type": "color", "$value": "#B84A06", "$description": "Laranja para texto sobre claro" }
    },
    "accent": {
      "base": { "$type": "color", "$value": "#FFD84D" },
      "subtle": { "$type": "color", "$value": "#FFF1B8" },
      "peach": { "$type": "color", "$value": "#FFE3BF" }
    },
    "neutral": {
      "ink": { "$type": "color", "$value": "#122334" },
      "inkMuted": { "$type": "color", "$value": "#4A5A68" },
      "canvas": { "$type": "color", "$value": "#FFF8EC" },
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "border": { "$type": "color", "$value": "#E6D9BD" },
      "borderStrong": { "$type": "color", "$value": "#D9CBAA" },
      "skeleton": { "$type": "color", "$value": "#F1E4C8" }
    },
    "danger": {
      "text": { "$type": "color", "$value": "#B3261E" },
      "subtle": { "$type": "color", "$value": "#FDEDEA" },
      "onSubtle": { "$type": "color", "$value": "#7A1A14" }
    }
  },
  "font": {
    "heading": { "$type": "fontFamily", "$value": ["Baloo 2", "Nunito", "system-ui", "sans-serif"] },
    "body": { "$type": "fontFamily", "$value": ["Nunito", "system-ui", "sans-serif"] },
    "hand": { "$type": "fontFamily", "$value": ["Caveat", "cursive"], "$description": "Somente slogan e notas curtas >= 24px" }
  },
  "radius": {
    "field": { "$type": "dimension", "$value": "16px" },
    "card": { "$type": "dimension", "$value": "28px" },
    "block": { "$type": "dimension", "$value": "40px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "14px", "spread": "0px", "color": "rgba(18,35,52,0.10)" } },
    "md": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px", "color": "rgba(18,35,52,0.10)" } },
    "lg": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px", "color": "rgba(18,35,52,0.12)" } },
    "step": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "0px", "spread": "0px", "color": "#B84A06" } }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "72px" },
    "9": { "$type": "dimension", "$value": "88px" }
  },
  "motion": {
    "easing": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1] },
    "duration": {
      "press": { "$type": "duration", "$value": "120ms" },
      "fast": { "$type": "duration", "$value": "350ms" },
      "medium": { "$type": "duration", "$value": "450ms" },
      "step": { "$type": "duration", "$value": "600ms" },
      "enter": { "$type": "duration", "$value": "700ms" },
      "bar": { "$type": "duration", "$value": "1400ms" },
      "counter": { "$type": "duration", "$value": "1600ms" }
    }
  }
}
